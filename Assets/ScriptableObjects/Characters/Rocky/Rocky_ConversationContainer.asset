  subFolder: Characters\Rocky\Conversations\Player
  maxEntries: 5
  summary: 
  entries:
  - Speaker: Player
    Text: Hi
    Timestamp: 40332.555
  - Speaker: Rocky
    Text: Hey, what's up?
    Timestamp: 40426.61
  - Speaker: Player
    Text: Just wanted to say hi to you
    Timestamp: 41092.66
  - Speaker: Rocky
    Text: Hey, thanks for reachin' out! I'm doin' alright, just gettin' my hands
      dirty in the mines. You know how it is. How 'bout you?
    Timestamp: 41350.645
  - Speaker: Player
    Text: Yeah i am trying to earn some money here
    Timestamp: 42451.01
  - Speaker: Rocky
    Text: Dude, I'm all about gettin' that mineral too! But we gotta make sure we're
      doin' it safe and smart. Don't wanna risk our necks or hurt nobody. We can
      work together on this, yeah?
    Timestamp: 42652.664
  - Speaker: Player
    Text: Yes, I have to go, see you later
    Timestamp: 44185.613
  - Speaker: Rocky
    Text: See you, Player. I'll be back to those mines in no time, and maybe then
      I'll show you my latest discovery.
    Timestamp: 44393.203
