  maxEntries: 5
  summary: 
  entries:
  - Speaker: Player
    Text: Hi, how you doing?
    Timestamp: 41009.965
  - Speaker: Rocky
    Text: Hey, I'm doin' alright. Been thinkin' about those minerals a lot lately.
    Timestamp: 41273.094
  - Speaker: Player
    Text: Minerals?
    Timestamp: 41971.508
  - Speaker: Rocky
    Text: What minerals? You think I'm just sitting around all day, waiting for someone
      to ask me about rocks? Get real.
    Timestamp: 42104.645
  - Speaker: Player
    Text: Who are you?
    Timestamp: 43215.22
  - Speaker: Rocky
    Text: '{"Who''s asking? You think you''re worthy of knowing me, huh?"}'
    Timestamp: 43318.336
  - Speaker: Player
    Text: Oh sorry, see you later
    Timestamp: 44865.508
  - Speaker: Rocky
    Text: Ha! You think you're done with me already? I'm just getting started, pal.
      See you later, indeed.
    Timestamp: 44975.91
