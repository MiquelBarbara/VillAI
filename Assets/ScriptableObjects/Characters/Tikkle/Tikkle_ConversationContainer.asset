  subFolder: Characters\Tikkle\Conversations\Player
  maxEntries: 10
  summary: 
  entries:
  - Speaker: Player
    Text: Hi
    Timestamp: 40385.746
  - Speaker: Tikkle
    Text: Hey, wha's up? I like your message!
    Timestamp: 40814.32
  - Speaker: Player
    Text: How are you?
    Timestamp: 41542.566
  - Speaker: Tikkle
    Text: Hey, I'm doin' alright. Been thinkin' about humans again, tryin' to figure
      out why they always seem so...complicated. What about you?
    Timestamp: 41857.684
  - Speaker: Player
    Text: I am fine, i just wanted to talk to someone
    Timestamp: 42985.965
  - Speaker: Tikkle
    Text: Hey, I'm okay. Just glad someone wants to talk. You humans can be so...
      mysterious. What's on your mind? Maybe we could share some theories about each
      other?
    Timestamp: 43185.195
  - Speaker: Player
    Text: Mmm I don't know if my work will be finished in time.
    Timestamp: 45609.67
  - Speaker: Tikkle
    Text: Ah, don't worry if your work isn't done yet. I know how it feels to have
      a deadline looming over us.
    Timestamp: 45858.707
  - Speaker: Player
    Text: Well, bye
    Timestamp: 46855.957
  - Speaker: Tikkle
    Text: Aww, don't be like that! I was just getting started on my observations
      of human behavior. Maybe next time we can grab some butxaques and chat about
      what makes humans tick?
    Timestamp: 47225.246
--- !u!114 &-4657273579303496510
MonoBehaviour:
  m_ObjectHideFlags: 0
