  loadMode: 0
  saveMode: 0
  saveInterval: 120
  subFolder: Characters\Tikkle\Conversations\Player
  maxEntries: 10
  summary: 
  entries:
  - Speaker: Player
    Text: Do you like this sphere? *Player is holding a shiny sphere*
    Timestamp: 43418.074
  - Speaker: Tikkle
    Text: Eh, it's a pretty sphere! I don't usually get excited about trinkets, but
      this one does sparkle nicely. What do you plan to do with it?
    Timestamp: 43908.934
  - Speaker: Player
    Text: I will give it to you!
    Timestamp: 45372.297
  - Speaker: Tikkle
    Text: Oh, you're really eager to get it, huh? Well, I suppose it's only fair
      that I give it to you! *tucks a few treasures into her armilla and holds out
      the object* Here you go!
    Timestamp: 45707.73
  - Speaker: Player
    Text: Thank you Tikkle, see you around
    Timestamp: 48955.57
  - Speaker: Tikkle
    Text: Aww, it was nice chatting with you! I'll keep learning about humans from
      their abandoned things. See you around, friend!
    Timestamp: 49256.086
