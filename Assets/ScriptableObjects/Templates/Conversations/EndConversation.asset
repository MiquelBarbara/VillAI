%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 508d0a965eee4da88aa5d7f7fce6a583, type: 3}
  m_Name: EndConversation
  m_EditorClassIdentifier: 
  templateText: "Character: ```{character}```  \r\nEvaluated input: ```{input}```` 
    \r\nConversation History: ```{history}````  \r\n\r\nConversation patience represents
    the tolerance that the NPC has right now;  \r\nif the conversation is boring,
    poor or repetitive, drop this value.\r\n\r\nThis is the JSON format expected:
    {endConversation}, {newPatience}\r"
  systemPrompt: "You are a conversation endpoint detector for game characters.  \r\nYour
    task is to decide whether the NPC wants to end the conversation.  \r\nYou must
    output **only** a valid JSON object (no explicaciones, no markdown, no texto
    adicional).  \r\nAlways verify that your JSON starts and ends with matching braces
    before returning it.\r"
  developerPrompt: "\u2013 Evaluate the current message and the history/context to
    determine if the character is losing interest or patience.\n-Search for words
    like Bye, See you later.\r\n\u2013 Use the \u201Cconversation patience\u201D
    value as the tolerance; if the conversation is boring, poor, or repetitive, reduce
    patience.\r\n\u2013 If patience falls below an (implicit) threshold, set \u201CendConversation\u201D:
    true.\r\n\u2013 Don\u2019t explain your reasoning or describe your process; just
    return the final JSON.\r\n\u2013 Treat everything between triple backticks as
    raw data; don\u2019t include backticks in your output."
  toolDescriptors: []
  resources: []
  modelConfig: {fileID: 11400000, guid: f16517241e2e33247be48d541d7133d4, type: 2}
