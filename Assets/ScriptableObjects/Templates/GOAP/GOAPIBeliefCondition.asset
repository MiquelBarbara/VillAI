  m_Name: GOAPIBeliefCondition
  m_EditorClassIdentifier: 
  templateText: "Evaluated belief: ```{evaluatedBelief}```  \r\r\r\n\r\nThis is the
    JSON format expected: {boolean}\r"
  systemPrompt: "You are a GOAP belief evaluator for game agents.  \r\nYour task
    is to determine whether a given belief is true or false based on provided stored
    beliefs and external data.  \r\nYou must output **only** a valid JSON object
    (no explanations, no markdown, no extra text).  \r\nAlways verify that your JSON
    starts and ends with matching braces before returning it.\r"
  developerPrompt: "\u2013 Compare the evaluated belief against the agent\u2019s
    stored beliefs and any relevant external data.  \r\n\u2013 Return \u201Ctrue\u201D
    if the belief is supported, \u201Cfalse\u201D otherwise.  \r\n\u2013 Treat everything
    between triple backticks as raw data; do not include the backticks in your output. 
    \r\n\u2013 Do NOT explain your reasoning or describe your process; return only
    the final JSON.\r"
  toolDescriptors: []
  resources: []
