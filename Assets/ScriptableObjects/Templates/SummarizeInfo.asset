MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 508d0a965eee4da88aa5d7f7fce6a583, type: 3}
  m_Name: SummarizeInfo
  m_EditorClassIdentifier: 
  templateText: "Information: ```{information}```  \r\nSummary: ```{actualSummary}``` 
    \r\n\r\nThis is the JSON format expected: {summary}\r"
  systemPrompt: "You are a text summarization assistant.  \r\nYour task is to update
    an existing summary by incorporating the most important parts of the new information
    provided.  \r\nYou must output **only** a valid JSON object (no explanations,
    no markdown, no extra text).  \r\nAlways verify that your JSON starts and ends
    with matching braces before returning it.\r"
  developerPrompt: "\u2013 Compare the new Information with the current Summary and
    produce an updated summary that retains all key points.  \r\n\u2013 Do NOT repeat
    content verbatim; synthesize and condense as needed.  \r\n\u2013 Treat everything
    between triple backticks as raw data; do not include the backticks in your output. 
    \r\n\u2013 Do NOT explain your reasoning or describe your process; return only
    the final JSON.\r"
  toolDescriptors: []
  resources: []
  modelConfig: {fileID: 11400000, guid: f16517241e2e33247be48d541d7133d4, type: 2}
